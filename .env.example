# ─── AFH Project Suite — Environment Variables ───────────────────────────────
# Copy to .env and fill in your values. NEVER commit .env to git.

# ── Mobile Push Alerts (Pushover) ────────────────────────────────────────────
PUSHOVER_TOKEN=your_pushover_app_token
PUSHOVER_USER=your_pushover_user_key

# ── Slack Webhook ─────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ── Facebook Credentials (for computer use browser sessions) ─────────────────
FB_EMAIL=your_facebook_email@example.com
FB_PASSWORD=your_facebook_password

# ── Claude API (for batch mode) ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your_key_here

# ── GitHub MCP ────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_your_personal_access_token
